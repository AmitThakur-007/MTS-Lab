{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      // Authenticated staff can list/read staff profiles for directory & assignments
      ".read": "auth != null",
      "$userId": {
        // Only SuperAdmins or the owner themselves can write to their user record.
        // If the owner writes, they CANNOT modify role, accountStatus, email, or firebaseUid.
        ".write": "auth != null && (
          (auth.token.email === 'mtsmobilelab@gmail.com' || auth.token.email === 'amitsharma64017900@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'SUPERADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN') ||
          ($userId === auth.uid && (
            !data.exists() || (
              newData.child('role').val() === data.child('role').val() &&
              newData.child('accountStatus').val() === data.child('accountStatus').val() &&
              newData.child('email').val() === data.child('email').val() &&
              (!data.child('firebaseUid').exists() || newData.child('firebaseUid').val() === data.child('firebaseUid').val())
            )
          ))
        )"
      },
      ".indexOn": ["email", "role", "branchId", "accountStatus", "firebaseUid", "createdAt", "updatedAt"]
    },

    "repairs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["repairNumber", "customerPhone", "technicianId", "status", "branchId", "createdAt", "updatedAt"]
    },

    "repairLogs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["repairId", "createdAt", "action"]
    },

    "technicianNotes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["repairId", "technicianId", "createdAt"]
    },

    "customers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["phone", "customerId", "name", "archived", "createdAt", "updatedAt"]
    },

    "inventory": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["category", "brand", "model", "sku", "status", "quantity", "createdAt", "updatedAt"]
    },

    "inventoryTransactions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["itemId", "type", "createdAt", "repairNumber", "branchId"]
    },

    "payments": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["repairId", "createdAt", "method", "status", "branchId"]
    },

    "products": {
      // Public product catalog for shop & customer facing displays
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["category", "brand", "model", "sku", "status"]
    },

    "branches": {
      // Public branch directory
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["name", "status"]
    },

    "repairPrices": {
      // Public pricing estimator
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["brand", "model", "category", "status"]
    },

    "homeSlides": {
      // Public landing page slideshow
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["status", "displayOrder"]
    },

    "publicTracking": {
      // Public status lookup (scoped data with no sensitive customer financials/internal notes)
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["repairNumber", "customerPhone"]
    },

    "batteryWarranties": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["repairNumber", "customerPhone", "warrantyNumber", "status", "expiryDate", "createdAt"]
    },

    "batteryWarrantyClaims": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["warrantyId", "claimNumber", "repairNumber", "status", "createdAt"]
    },

    "couriers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "repairId", "trackingNumber", "courierPartner", "createdAt"]
    },

    "attendances": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["userId", "date", "status", "branchId"]
    },

    "damageRecords": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["staffId", "repairId", "status", "damageDate"]
    },

    "accessRequests": {
      // Allow reading by authenticated staff; allow writing by authenticated staff or pending device submission
      ".read": "auth != null",
      ".write": "auth != null || (newData.child('email').isString() && newData.child('status').val() === 'PENDING')",
      ".indexOn": ["email", "status", "deviceIdentifier", "createdAt"]
    },

    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["userId", "isRead", "type", "createdAt"]
    },

    "syncTimestamp": {
      // Public heartbeat and sync trigger signal for real-time multi-device refresh
      ".read": true,
      ".write": true
    }
  }
}
