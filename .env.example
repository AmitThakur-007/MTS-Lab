# ==========================================
# MTS LAB 2FA & PRODUCTION EMAIL CONFIGURATION
# ==========================================

# Option A: Custom SMTP Provider (SendGrid, Mailgun, AWS SES, Brevo, Postmark)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="MTS Lab Security" <no-reply@mtslab.com>

# Option B: Direct Gmail SMTP (Using Gmail App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cryptographic Salt & JWT Secrets
OTP_SALT=
JWT_SECRET=
