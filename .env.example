# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ==========================================
# MTS LAB 2FA & PRODUCTION EMAIL CONFIGURATION
# ==========================================

# Option A: Custom SMTP Provider (SendGrid, Mailgun, AWS SES, Brevo, Postmark)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="MTS Lab Security" <no-reply@mtslab.com>

# Option B: Direct Gmail SMTP (Using Gmail App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cryptographic Salt & JWT Secrets (Overrides built-in secure fallbacks)
OTP_SALT=
JWT_SECRET=

# ==========================================
# FIREBASE WEB SDK CONFIGURATION (NEXT.JS & VERCEL)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==========================================
# HOSTED POSTGRESQL PRODUCTION DATABASE
# Supported: Supabase, Neon, Railway, GCP Cloud SQL, AWS RDS, Render
# ==========================================
DATABASE_URL=
DIRECT_URL=
