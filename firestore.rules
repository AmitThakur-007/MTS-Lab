rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL HELPER FUNCTIONS & GUARDS
    // =========================================================================
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email == 'mtsmobilelab@gmail.com') ||
        (request.auth.token.email == 'amitsharma64017900@gmail.com') ||
        (request.auth.token.email == 'admin@mtslab.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN', 'SUPERADMIN'])
      ); 
    }

    function isTechnicianOrAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['TECHNICIAN', 'HEAD_TECHNICIAN', 'LEAD_TECHNICIAN', 'MANAGER', 'RECEPTIONIST'])
      );
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128; 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    // =========================================================================
    // 1. USERS & STAFF PROFILES
    // =========================================================================
    match /users/{userId} {
      // Authenticated staff can list/read user accounts for assignment and directory
      allow read: if isSignedIn();

      // Create: User self-registration default to RECEPTIONIST/PENDING without privilege escalation
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && (!('role' in incoming()) || incoming().role == 'RECEPTIONIST'))
      );

      // Update: Admin full update; User can update own non-sensitive profile fields
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && 
         (!('role' in incoming()) || incoming().role == existing().role) &&
         (!('accountStatus' in incoming()) || incoming().accountStatus == existing().accountStatus) &&
         (!('email' in incoming()) || incoming().email == existing().email))
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. BRANCHES
    // =========================================================================
    match /branches/{branchId} {
      allow read: if true; // Public branch directory for website & store selector
      allow write: if isAdmin();
    }

    // =========================================================================
    // 3. REPAIRS & TICKETING
    // =========================================================================
    match /repairs/{repairId} {
      allow read: if isSignedIn() || true; // Allow public tracking query lookup
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /repairLogs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /technicianNotes/{noteId} {
      allow read: if isSignedIn();
      allow create, update: if isTechnicianOrAdmin();
      allow delete: if isAdmin();
    }

    match /repairTransfers/{transferId} {
      allow read, write: if isSignedIn();
    }

    match /repairTransferHistory/{historyId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // 4. CUSTOMERS
    // =========================================================================
    match /customers/{customerId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. INVENTORY & SPARE PARTS
    // =========================================================================
    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /inventoryItems/{itemId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /inventoryCategories/{categoryId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /inventoryFolders/{folderId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /inventoryTransactions/{transactionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. PAYMENTS & FINANCIALS
    // =========================================================================
    match /payments/{paymentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. PUBLIC CATALOGS & MARKETING (PRICES, SLIDES, PRODUCTS)
    // =========================================================================
    match /repairPrices/{priceId} {
      allow read: if true; // Public pricing estimator on website
      allow write: if isAdmin();
    }

    match /homeSlides/{slideId} {
      allow read: if true; // Public hero slider on landing page
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true; // Public shop catalog items
      allow write: if isAdmin();
    }

    // =========================================================================
    // 8. BATTERY WARRANTIES & CLAIMS
    // =========================================================================
    match /batteryWarranties/{warrantyId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /batteryWarrantyClaims/{claimId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 9. COURIER LOGISTICS
    // =========================================================================
    match /couriers/{courierId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 10. ATTENDANCE & ACCIDENTAL DAMAGE RECORDS
    // =========================================================================
    match /attendances/{attendanceId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /damageRecords/{recordId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /repairRelatedDamage/{recordId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 11. MULTI-DEVICE ACCESS REQUESTS & APPROVED DEVICES
    // =========================================================================
    match /accessRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if true; // Unauthenticated login page device approval requests
      allow update, delete: if isAdmin();
    }

    match /approvedDevices/{deviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 12. NOTIFICATIONS & AUDIT LOGS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Tamper-proof audit trail
    }

    // =========================================================================
    // 13. SESSIONS & SYSTEM SETTINGS
    // =========================================================================
    match /sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 14. DEFAULT FALLBACK CATCH-ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
